<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Form</title>

    <style>
        :root {
            --blue: #2563eb;
            --bg: #f5f5f5;
            --gap: 15px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial;
            background: var(--bg);
        }

        header {
            background: var(--blue);
            color: white;
            text-align: center;
            padding: 20px;
        }

        nav {
            display: flex;
            justify-content: center;
            gap: 25px;
            padding: 15px;
            background: white;
        }

        nav a {
            text-decoration: none;
            color: var(--blue);
        }

        main {
            max-width: 900px;
            margin: 30px auto;
            padding: 15px;
        }

        .content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--gap);
        }

        section {
            background: white;
            padding: 20px;
            border-radius: 8px;
        }

        .courses {
            display: flex;
            gap: var(--gap);
            margin-top: 20px;
        }

        .course {
            background: var(--bg);
            padding: 20px;
            text-align: center;
            flex: 1;
        }

        form {
            display: grid;
            gap: 10px;
        }

        input, select, textarea, button {
            padding: 10px;
            width: 100%;
        }

        button {
            background: var(--blue);
            color: white;
            border: none;
        }

        footer {
            text-align: center;
            background: white;
            padding: 15px;
            margin-top: 30px;
        }

        @media (max-width: 600px) {
            .content {
                grid-template-columns: 1fr;
            }

            .courses {
                flex-direction: column;
            }

            nav {
                flex-direction: column;
                align-items: center;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>Student Registration</h1>
        <p>Register for a course</p>
    </header>

    <nav>
        <a href="#about">About</a>
        <a href="#courses">Courses</a>
        <a href="#form">Register</a>
    </nav>

    <main>
        <div class="content">

            <section id="about">
                <h2>About</h2>
                <p>
                    This website is made for students
                    who want to join a course.
                </p>

                <div class="courses" id="courses">
                    <div class="course">HTML</div>
                    <div class="course">CSS</div>
                    <div class="course">JavaScript</div>
                </div>
            </section>

            <section id="form">
                <h2>Registration Form</h2>

                <form>
                    <label for="name">Name</label>
                    <input type="text" id="name" placeholder="Enter your name" required>

                    <label for="email">Email</label>
                    <input type="email" id="email" placeholder="Enter your email" required>

                    <label for="course">Course</label>
                    <select id="course">
                        <option>HTML</option>
                        <option>CSS</option>
                        <option>JavaScript</option>
                    </select>

                    <label for="message">Message</label>
                    <textarea id="message" placeholder="Enter your message"></textarea>

                    <button type="submit">Submit</button>
                </form>
            </section>

        </div>
    </main>

    <footer>
        <p>Student Registration Page</p>
    </footer>

</body>
</html>
